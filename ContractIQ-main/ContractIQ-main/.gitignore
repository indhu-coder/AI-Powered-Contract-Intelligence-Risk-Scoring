# ---- ContractIQ .gitignore ----

# Immutable source data & extracted copies
data.zip
data/raw/
data/processed/

# Databases
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ML artifacts - the BUNDLED FINAL MODEL (ml/models/final) is intentionally
# tracked: it is required for offline inference (see FINAL_STATUS.md).
# Note: model.safetensors (~133 MB) exceeds GitHub's 100 MB file limit -
# use Git LFS or a GitHub Release asset when publishing (docs/DEPLOYMENT.md).
ml/checkpoints/
ml/models/*
!ml/models/final/
!ml/models/final/**
ml/artifacts/
*.pt
*.bin
*.onnx
!ml/models/final/*.safetensors

# Hugging Face cache
.cache/
hf_cache/
models--/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Secrets & environment
.env
.env.*
!.env.example

# Uploads / runtime artifacts
uploads/
backend/uploads/
storage/uploads/
storage/temp/
storage/*.db

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
logs/
*.log

# ---- GitHub publishing: keep the repo free of large files ----
# The fine-tuned weights (model.safetensors, ~127 MB) exceed GitHub's 100 MB
# limit. The app falls back to the public deepset/minilm-uncased-squad2
# baseline (auto-downloaded from Hugging Face on first run). To publish the
# fine-tuned model, attach it to a GitHub Release or use Git LFS
# (see docs/DEPLOYMENT.md).
ml/models/final/model.safetensors

# Presentation assets: QA renders & video build stay local; only the
# final deliverables (deck + report) are published.
reports/deck_assets/**
!reports/deck_assets/ContractIQ_Presentation.pptx
!reports/deck_assets/ContractIQ_Technical_Report.docx
!reports/deck_assets/ContractIQ_Technical_Report.pdf

# Runtime demo leftover
storage/demo_services_agreement.docx

# BERT checkpoints and downloaded model copies
bert-cuad-qa-transformers-default-v4/
bert_cuad_download/

# Generated validation outputs
bert_validation_predictions.csv
validation_results.zip
validation_results/

# Python caches
__pycache__/
*.py[cod]

/ml/models/final/model.safetensors
